# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# === APPLICATION ===
NODE_ENV=production
PORT=5000

# === DATABASE ===
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gocab?retryWrites=true&w=majority
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secure_password_123

# === CACHE ===
REDIS_URL=redis://localhost:6379

# === AUTHENTICATION ===
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# === PAYMENT GATEWAYS ===
# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# === SMS & OTP ===
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# === PUSH NOTIFICATIONS ===
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/serviceAccountKey.json

# === MAPS ===
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === AWS ===
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=gocab-uploads

# === MONITORING & LOGGING ===
GRAFANA_PASSWORD=secure_grafana_password
LOG_LEVEL=info
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# === EMAIL ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=noreply@gocab.app

# === API URLs ===
FRONTEND_URL=https://app.gocab.com
ADMIN_URL=https://admin.gocab.com
API_URL=https://api.gocab.com

# === FEATURE FLAGS ===
ENABLE_WALLET=true
ENABLE_REFERRALS=true
ENABLE_SURGE_PRICING=true
ENABLE_DIASPORA_RIDES=true
ENABLE_ESCORT_RIDES=true

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === SECURITY ===
CORS_ORIGIN=https://app.gocab.com,https://admin.gocab.com
SESSION_SECRET=your_session_secret_key_here

# === DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION) ===
DEBUG=false
SKIP_KYC=false
